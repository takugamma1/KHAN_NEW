{% liquid
  assign s = section.settings
  assign has_video = false
  if s.media_type == 'video' and s.background_video != blank
    assign has_video = true
  endif
  assign has_video_m = false
  if has_video and s.background_video_mobile != blank
    assign has_video_m = true
  endif
  assign has_image = false
  if s.media_type == 'image' and s.background_image != blank
    assign has_image = true
  endif
%}

<div
  id="KhanPw-{{ section.id }}"
  class="khan-pw{% if has_image and s.background_image_mobile != blank %} khan-pw--mobmedia{% endif %}{% if has_video_m %} khan-pw--mobmedia{% endif %}{% if s.frame_image_mobile != blank %} khan-pw--mobframe{% endif %}"
  style="
    --pw-bg: {{ s.bg_color }};
    --pw-text: {{ s.text_color }};
    --pw-muted: {{ s.muted_color }};
    --pw-accent: {{ s.accent_color }};
    --pw-accent-2: {{ s.accent_color_2 }};
    --pw-outline: {{ s.field_outline | default: '#ffffff' }};
    --pw-fill: {{ s.field_fill | default: 0 | divided_by: 100.0 }};
    --pw-blur: {{ s.blur }}px;
    --pw-media-opacity: {{ s.media_opacity | default: 100 | divided_by: 100.0 }};
    --pw-shade: {{ s.shade | default: 45 | divided_by: 100.0 }};
    --pw-frame-fit: {{ s.frame_fit | default: 'cover' }};
    --pw-logo-w: {{ s.logo_width }}px;
    --pw-logo-w-m: {{ s.logo_width_mobile }}px;
    --pw-gap: {{ s.content_gap }}px;
    --pw-offset: {{ s.content_offset }}px;
  "
  data-khan-password
>
  {%- if s.show_particles -%}
    {% render 'khan-particles', count: s.particle_count, size: s.particle_size, color1: s.particle_color, color2: s.particle_color_2, direction: s.particle_dir %}
  {%- endif -%}

  {%- comment -%} Layer 1: background media {%- endcomment -%}
  <div class="khan-pw__media" aria-hidden="true">
    {%- if has_image -%}
      {{ s.background_image | image_url: width: 3840 | image_tag: class: 'khan-pw__media-item khan-pw__media-item--d', widths: '832, 1200, 1600, 1920, 2560, 3840', sizes: '100vw', fetchpriority: 'high', alt: '' }}
      {%- if s.background_image_mobile != blank -%}
        {{ s.background_image_mobile | image_url: width: 1600 | image_tag: class: 'khan-pw__media-item khan-pw__media-item--m', widths: '600, 900, 1200, 1600', sizes: '100vw', alt: '' }}
      {%- endif -%}
    {%- elsif has_video -%}
      {{ s.background_video | video_tag: poster: nil, autoplay: true, loop: true, controls: false, muted: true, class: 'khan-pw__media-item khan-pw__media-item--d', data-khan-autoplay: 'true' }}
      {%- if has_video_m -%}
        {{ s.background_video_mobile | video_tag: poster: nil, autoplay: true, loop: true, controls: false, muted: true, class: 'khan-pw__media-item khan-pw__media-item--m', data-khan-autoplay: 'true' }}
      {%- endif -%}
    {%- endif -%}
  </div>

  {%- comment -%} Layer 2: the rocks frame {%- endcomment -%}
  {%- if s.frame_image != blank -%}
    <div class="khan-pw__frame" aria-hidden="true">
      {{ s.frame_image | image_url: width: 3840 | image_tag: class: 'khan-pw__frame-img khan-pw__frame-img--d', widths: '832, 1200, 1600, 1920, 2560, 3840', sizes: '100vw', fetchpriority: 'high', alt: '' }}
      {%- if s.frame_image_mobile != blank -%}
        {{ s.frame_image_mobile | image_url: width: 1600 | image_tag: class: 'khan-pw__frame-img khan-pw__frame-img--m', widths: '600, 900, 1200, 1600', sizes: '100vw', alt: '' }}
      {%- endif -%}
    </div>
  {%- endif -%}

  <span class="khan-pw__shade" aria-hidden="true"></span>

  {%- comment -%} Layer 3: logo + password form {%- endcomment -%}
  <div class="khan-pw__inner">
    <div class="khan-pw__logo{% if s.logo_pulse %} khan-pw__logo--pulse{% endif %}">
      {%- if s.logo != blank -%}
        {{ s.logo | image_url: width: 1200 | image_tag: widths: '240, 480, 832, 1200', alt: shop.name, class: 'khan-pw__logo-img' }}
      {%- else -%}
        {{ 'white-logo.svg' | inline_asset_content }}
      {%- endif -%}
      <h1 class="visually-hidden">{{ shop.name }}</h1>
    </div>

    {%- if s.eyebrow != blank -%}
      <p class="khan-pw__eyebrow"><span class="khan-pw__flag" aria-hidden="true"></span>{{ s.eyebrow }}</p>
    {%- endif -%}

    {%- if s.use_shop_message and shop.password_message != blank -%}
      <div class="khan-pw__message"><p>{{ shop.password_message }}</p></div>
    {%- elsif s.message != blank -%}
      <div class="khan-pw__message">{{ s.message }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'khan-pw__form' -%}
      <label class="visually-hidden" for="KhanPassword-{{ section.id }}">{{ s.placeholder | default: 'Парола' }}</label>
      <div class="khan-pw__field{% if form.errors %} khan-pw__field--error{% endif %}">
        <div class="khan-pw__input-wrap">
        <svg class="khan-pw__lock" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 10V8a6 6 0 1 1 12 0v2" stroke="currentColor" stroke-width="2"/><path d="M4 10h16l-1.2 11H5.2L4 10Z" fill="currentColor"/></svg>
        <input
          class="khan-pw__input"
          type="password"
          name="password"
          id="KhanPassword-{{ section.id }}"
          autocomplete="current-password"
          placeholder="{{ s.placeholder | default: 'Парола' | escape }}"
          required
          {% if form.errors %}aria-invalid="true" aria-describedby="KhanPasswordError-{{ section.id }}" autofocus{% endif %}
        >
        </div>
        <button class="khan-pw__btn" type="submit">
          <span class="khan-pw__btn-inner">{{ s.button_label | default: 'Вход' }}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15M13 6l7 6-7 6" stroke="currentColor" stroke-width="2.4"/></svg></span>
        </button>
      </div>
      {%- if form.errors -%}
        <p class="khan-pw__error" id="KhanPasswordError-{{ section.id }}" role="alert">{{ s.error_text | default: 'Грешна парола. Опитай отново.' }}</p>
      {%- endif -%}
    {%- endform -%}

    {%- if s.show_signup -%}
      {%- form 'customer', class: 'khan-pw__signup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,password page">
        {%- if form.posted_successfully? -%}
          <p class="khan-pw__signup-ok" role="status">{{ s.signup_success }}</p>
        {%- else -%}
          {%- if s.signup_heading != blank -%}<p class="khan-pw__signup-head">{{ s.signup_heading }}</p>{%- endif -%}
          <div class="khan-pw__field khan-pw__field--ghost">
            <label class="visually-hidden" for="KhanPwEmail-{{ section.id }}">{{ s.signup_placeholder }}</label>
            <div class="khan-pw__input-wrap"><input class="khan-pw__input" type="email" name="contact[email]" id="KhanPwEmail-{{ section.id }}" autocomplete="email" placeholder="{{ s.signup_placeholder | escape }}" required></div>
            <button class="khan-pw__btn khan-pw__btn--outline" type="submit"><span class="khan-pw__btn-inner">{{ s.signup_button }}</span></button>
          </div>
          {%- if form.errors -%}<p class="khan-pw__error" role="alert">{{ form.errors.messages | first }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}
  </div>

  {%- if s.footer_text != blank -%}
    <p class="khan-pw__footer">{{ s.footer_text }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  /* the password layout: this section owns the whole screen */
  body:has(.khan-pw) { background: #000; margin: 0; }
  body:has(.khan-pw) > footer { display: none; }
  body:has(.khan-pw) .password-main-content { display: block; padding: 0; margin: 0; max-width: none; width: 100%; }
  .khan-pw-wrapper { width: 100%; grid-column: 1 / -1; }

  .khan-pw {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 100vh; min-height: 100svh;
    background: var(--pw-bg, #000);
    color: var(--pw-text, #f3f3f3);
    display: flex; align-items: center; justify-content: center;
    padding: calc(48px + env(safe-area-inset-top, 0px)) 20px calc(72px + env(safe-area-inset-bottom, 0px));
    box-sizing: border-box;
  }

  .khan-pw__media, .khan-pw__frame, .khan-pw__shade { position: absolute; inset: 0; pointer-events: none; }
  .khan-pw__media { z-index: 0; opacity: var(--pw-media-opacity, 1) !important; }
  .khan-pw__media-item, .khan-pw__media img, .khan-pw__media video {
    width: 100%; height: 100%; object-fit: cover; object-position: center; display: block;
  }
  .khan-pw__frame { z-index: 2; }
  .khan-pw__frame-img { width: 100%; height: 100%; object-fit: var(--pw-frame-fit, cover); object-position: center; display: block; }
  .khan-pw__media-item--m, .khan-pw__frame-img--m { display: none; }
  /* dark overlay over the whole background so the logo + form stay readable over any footage */
  .khan-pw__shade { z-index: 3; background: rgb(0 0 0 / var(--pw-shade, 0.45)); }

  .khan-pw__inner {
    position: relative; z-index: 4;
    width: 100%; max-width: 520px;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: var(--pw-gap, 22px);
    transform: translateY(var(--pw-offset, 0px));
  }

  /* logo */
  .khan-pw__logo { width: var(--pw-logo-w, 260px); max-width: 78vw; display: flex; align-items: center; justify-content: center; margin-bottom: 6px; }
  .khan-pw__logo img, .khan-pw__logo svg { width: 100%; height: auto; display: block; }
  .khan-pw__logo svg path { fill: #fff; }
  @media (prefers-reduced-motion: no-preference) {
    .khan-pw__logo--pulse { animation: khan-pw-pulse 3.2s ease-in-out infinite; will-change: transform, opacity; }
  }
  @keyframes khan-pw-pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.035); opacity: 0.9; } }

  /* copy */
  .khan-pw__eyebrow, .khan-pw__message, .khan-pw__input, .khan-pw__error, .khan-pw__footer, .khan-pw__signup-head, .khan-pw__signup-ok {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }
  .khan-pw__eyebrow { margin: 0; display: inline-flex; align-items: center; gap: 12px; font-size: 12px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--pw-text, #f3f3f3); }
  .khan-pw__flag { width: 28px; height: 9px; background: var(--pw-accent, #9A1F33); clip-path: polygon(5px 0, 100% 0, calc(100% - 5px) 100%, 0 100%); }
  .khan-pw__message { font-size: 12px; line-height: 1.7; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pw-muted, #bdbdbd); max-width: 44ch; }
  .khan-pw__message p { margin: 0 0 6px; }
  .khan-pw__message p:last-child { margin-bottom: 0; }

  /* password field: transparent pill with a white outline + brand button beside it */
  .khan-pw__form, .khan-pw__signup { width: 100%; margin: 0; }
  .khan-pw__field { display: flex; align-items: stretch; gap: 10px; width: 100%; box-sizing: border-box; }
  .khan-pw__input-wrap {
    flex: 1 1 auto; min-width: 0; display: flex; align-items: center; gap: 12px;
    height: 54px; box-sizing: border-box; padding: 0 22px;
    background: rgb(0 0 0 / var(--pw-fill, 0));
    -webkit-backdrop-filter: blur(var(--pw-blur, 0px)); backdrop-filter: blur(var(--pw-blur, 0px));
    border: 1.5px solid var(--pw-outline, #fff);
    border-radius: 999px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .khan-pw__input-wrap:focus-within { box-shadow: 0 0 0 3px rgb(255 255 255 / 0.22); }
  .khan-pw__field--error .khan-pw__input-wrap { border-color: #ff5a6b; }
  .khan-pw__lock { flex: 0 0 auto; width: 16px; height: 16px; color: var(--pw-outline, #fff); }
  /* the theme styles every <input> (hover background, radius) — pin ours down */
  .khan-pw .khan-pw__input,
  .khan-pw .khan-pw__input:hover,
  .khan-pw .khan-pw__input:focus,
  .khan-pw .khan-pw__input:focus-visible {
    flex: 1 1 auto; min-width: 0; height: 100%; box-sizing: border-box;
    appearance: none; -webkit-appearance: none;
    background: transparent !important; border: 0 !important; border-radius: 0 !important;
    outline: 0 !important; box-shadow: none !important;
    padding: 0; margin: 0;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 16px; letter-spacing: 0.18em;
    color: var(--pw-text, #fff) !important; -webkit-text-fill-color: var(--pw-text, #fff); caret-color: var(--pw-text, #fff);
  }
  .khan-pw .khan-pw__input::placeholder { color: var(--pw-text, #fff) !important; -webkit-text-fill-color: var(--pw-text, #fff); opacity: 0.85; text-transform: uppercase; font-size: 12px; letter-spacing: 0.24em; }
  .khan-pw .khan-pw__input:-webkit-autofill { -webkit-text-fill-color: var(--pw-text, #fff); transition: background-color 99999s ease-out 0s; }

  .khan-pw__btn {
    flex: 0 0 auto; appearance: none; border: 0; padding: 0; margin: 0; cursor: pointer;
    background: linear-gradient(180deg, var(--pw-accent, #9A1F33), var(--pw-accent-2, #560B1E));
    color: #fff; border-radius: 999px;
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .khan-pw__btn:hover { transform: translateY(-1px); filter: brightness(1.1); }
  .khan-pw__btn-inner {
    display: inline-flex; align-items: center; gap: 10px; height: 54px; padding: 0 30px;
    font-family: 'Nexa', var(--font-heading--family, sans-serif); font-weight: 900;
    font-size: 13px; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap;
  }
  .khan-pw__btn-inner svg { width: 16px; height: 16px; }
  .khan-pw__btn--outline { background: transparent; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.4); }
  .khan-pw__btn--outline:hover { background: rgb(255 255 255 / 0.1); }

  .khan-pw__error { margin: 12px 0 0; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; color: #ff7a88; }

  /* optional signup */
  .khan-pw__signup { margin-top: 6px; }
  .khan-pw__signup-head { margin: 0 0 10px; font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: var(--pw-muted, #bdbdbd); }
  .khan-pw__signup-ok { margin: 0; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--pw-text, #f3f3f3); }

  .khan-pw__footer {
    position: absolute; z-index: 4; left: 0; right: 0; bottom: calc(22px + env(safe-area-inset-bottom, 0px)); margin: 0;
    text-align: center; font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase; color: var(--pw-muted, #bdbdbd); opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .khan-pw--mobmedia .khan-pw__media-item--d, .khan-pw--mobframe .khan-pw__frame-img--d { display: none; }
    .khan-pw--mobmedia .khan-pw__media-item--m, .khan-pw--mobframe .khan-pw__frame-img--m { display: block; }
    .khan-pw__logo { width: var(--pw-logo-w-m, 220px); }
    .khan-pw__input-wrap { height: 50px; padding: 0 18px; }
    .khan-pw__btn-inner { height: 50px; padding: 0 20px; font-size: 12px; }
    .khan-pw__message { font-size: 11px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KHAN password page",
  "tag": "section",
  "class": "khan-pw-wrapper",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "header", "content": "Background media" },
    { "type": "select", "id": "media_type", "label": "Type", "options": [ { "value": "image", "label": "Image" }, { "value": "video", "label": "Video" } ], "default": "video" },
    { "type": "image_picker", "id": "background_image", "label": "Background image", "visible_if": "{{ section.settings.media_type == 'image' }}" },
    { "type": "image_picker", "id": "background_image_mobile", "label": "Background image — mobile", "visible_if": "{{ section.settings.media_type == 'image' }}" },
    { "type": "video", "id": "background_video", "label": "Background video", "visible_if": "{{ section.settings.media_type == 'video' }}" },
    { "type": "video", "id": "background_video_mobile", "label": "Background video — mobile", "info": "Portrait video for phones. Leave empty to reuse the desktop video.", "visible_if": "{{ section.settings.media_type == 'video' }}" },
    { "type": "range", "id": "media_opacity", "label": "Background opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "shade", "label": "Dark overlay over the background", "min": 0, "max": 95, "step": 5, "unit": "%", "default": 45, "info": "Darkens the whole video/image so the logo and the form stay readable." },
    { "type": "color", "id": "bg_color", "label": "Background colour", "default": "#000000" },

    { "type": "header", "content": "Rocks frame" },
    { "type": "image_picker", "id": "frame_image", "label": "Frame image", "info": "The rocks PNG that sits over the background, same as the home hero." },
    { "type": "image_picker", "id": "frame_image_mobile", "label": "Frame image — mobile" },
    { "type": "select", "id": "frame_fit", "label": "Frame fit", "options": [ { "value": "cover", "label": "Fill (crops)" }, { "value": "contain", "label": "Fit whole image" } ], "default": "cover" },

    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the bundled white KHAN logo." },
    { "type": "range", "id": "logo_width", "label": "Logo width — desktop", "min": 100, "max": 600, "step": 10, "unit": "px", "default": 280 },
    { "type": "range", "id": "logo_width_mobile", "label": "Logo width — mobile", "min": 80, "max": 400, "step": 10, "unit": "px", "default": 220 },
    { "type": "checkbox", "id": "logo_pulse", "label": "Pulse the logo", "default": true },

    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Затворен достъп" },
    { "type": "richtext", "id": "message", "label": "Message", "default": "<p>Отваряме скоро. Въведи паролата, за да влезеш.</p>" },
    { "type": "checkbox", "id": "use_shop_message", "label": "Use the message from Online Store → Preferences instead", "default": false },

    { "type": "header", "content": "Password form" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Парола" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Вход" },
    { "type": "text", "id": "error_text", "label": "Wrong password message", "default": "Грешна парола. Опитай отново." },

    { "type": "header", "content": "Email signup (optional)" },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup under the password", "default": false },
    { "type": "text", "id": "signup_heading", "label": "Heading", "default": "Научи първи, когато отворим" },
    { "type": "text", "id": "signup_placeholder", "label": "Placeholder", "default": "Имейл" },
    { "type": "text", "id": "signup_button", "label": "Button", "default": "Запиши ме" },
    { "type": "text", "id": "signup_success", "label": "Success message", "default": "Благодарим! Ще ти пишем първи." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "content_gap", "label": "Gap between elements", "min": 8, "max": 60, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "content_offset", "label": "Nudge content up / down", "min": -200, "max": 200, "step": 10, "unit": "px", "default": 0 },
    { "type": "text", "id": "footer_text", "label": "Footer line", "default": "© KHAN · Built different" },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f3f3f3" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#bdbdbd" },
    { "type": "color", "id": "accent_color", "label": "Accent (button top)", "default": "#9A1F33" },
    { "type": "color", "id": "accent_color_2", "label": "Accent (button bottom)", "default": "#560B1E" },
    { "type": "color", "id": "field_outline", "label": "Field outline", "default": "#ffffff" },
    { "type": "range", "id": "field_fill", "label": "Field fill darkness", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 0, "info": "0 = fully transparent inside." },
    { "type": "range", "id": "blur", "label": "Field blur", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Particles" },
    { "type": "checkbox", "id": "show_particles", "label": "Show particles", "default": true },
    { "type": "range", "id": "particle_count", "label": "Particle count", "min": 0, "max": 400, "step": 10, "default": 50 },
    { "type": "range", "id": "particle_size", "label": "Particle size", "min": 1, "max": 6, "step": 1, "unit": "px", "default": 2 },
    { "type": "color", "id": "particle_color", "label": "Particle color 1", "default": "#560B1E" },
    { "type": "color", "id": "particle_color_2", "label": "Particle color 2", "default": "#dfdfdf" },
    { "type": "select", "id": "particle_dir", "label": "Particle direction", "options": [ { "value": "down", "label": "Falling (blood drops)" }, { "value": "up", "label": "Rising" } ], "default": "down" }
  ],
  "presets": [ { "name": "KHAN password page" } ]
}
{% endschema %}
